#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use Symfony\Component\Console\Application;
use Doctrine\Migrations\Tools\Console\Command;
use ExchangeRate\Application\Service\CollectRateService;
use ExchangeRate\Application\Service\TradingDayService;
use ExchangeRate\Application\Service\ExchangeRateDataService;
use ExchangeRate\Application\Service\ExchangeRateDayService;
use ExchangeRate\Infrastructure\Persistence\Doctrine\ExchangeRateDataRepository;
use ExchangeRate\Infrastructure\Persistence\Doctrine\ExchangeRateDayRepository;
use ExchangeRate\Infrastructure\Messaging\CollectRateDispatcher;

$dependencyFactory = require __DIR__ . '/../config/migrations.php';
// we have $entityManager;
$app = new Application('Exchange Rate', '1.0.0');
$tdService = new TradingDayService();
$erDataRepository = new ExchangeRateDataRepository($entityManager);
$erDataService = new ExchangeRateDataService($erDataRepository);
$erDayRepository = new ExchangeRateDayRepository($entityManager);
$erDayService = new ExchangeRateDayService($erDayRepository);
$dispatcher = new CollectRateDispatcher($_ENV['RABBITMQ_HOST'],(int) $_ENV['RABBITMQ_PORT'], $_ENV['RABBITMQ_USER'], $_ENV['RABBITMQ_PASSWORD'], $_ENV['RABBITMQ_VHOST']);
$crService = new CollectRateService($tdService, $erDataService, $erDayService, $dispatcher);
$app->addCommands([
    new Command\DiffCommand($dependencyFactory),
    new Command\MigrateCommand($dependencyFactory),
    new Command\StatusCommand($dependencyFactory),
]);

$app->add(
    new \ExchangeRate\Presentation\Console\CollectRateCommand($crService)
);

$app->run();
