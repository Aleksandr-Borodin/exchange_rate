DB_HOST="mysql"
DB_PORT=3306
DB_NAME="rates_db"
DB_USER="mysql_user_name"
DB_PASSWORD="mysql_user_pass"
MYSQL_ROOT_PASSWORD="mysql_root_user_pass"

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DSN="redis://${REDIS_HOST}:${REDIS_PORT}"

RABBITMQ_USER="rabbitmq_user"
RABBITMQ_PASSWORD="rabbitmq_pass"
RABBITMQ_PORT=5672
RABBITMQ_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:${RABBITMQ_PORT}/%2f"
